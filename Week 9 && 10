/* ---------- TEXT load ---------- */
int loadEmployeesText()
{
    FILE *fp = fopen(DATA_DIR "/employees.txt", "r");
    if (fp == NULL) { printf("No employees.txt found (nothing to load).\n"); return 0; }
    employeeCount = 0;
    while (employeeCount < MAX &&
           fscanf(fp, "%d|%49[^|]|%f", &employees[employeeCount].id,
                  employees[employeeCount].name, &employees[employeeCount].salary) == 3)
        employeeCount++;
    fclose(fp);
    return 1;
}

int loadSuppliersText()
{
    FILE *fp = fopen(DATA_DIR "/suppliers.txt", "r");
    if (fp == NULL) { printf("No suppliers.txt found (nothing to load).\n"); return 0; }
    supplierCount = 0;
    while (supplierCount < MAX &&
           fscanf(fp, "%d|%49[^|]|%29[^\n]", &suppliers[supplierCount].id,
                  suppliers[supplierCount].name, suppliers[supplierCount].town) == 3)
        supplierCount++;
    fclose(fp);
    return 1;
}

int loadAssetsText()
{
    FILE *fp = fopen(DATA_DIR "/assets.txt", "r");
    if (fp == NULL) { printf("No assets.txt found (nothing to load).\n"); return 0; }
    assetCount = 0;
    while (assetCount < MAX &&
           fscanf(fp, "%d|%49[^|]|%f", &assets[assetCount].id,
                  assets[assetCount].name, &assets[assetCount].value) == 3)
        assetCount++;
    fclose(fp);
    return 1;
}

int loadBudgetsText()
{
    FILE *fp = fopen(DATA_DIR "/budgets.txt", "r");
    if (fp == NULL) { printf("No budgets.txt found (nothing to load).\n"); return 0; }
    budgetCount = 0;
    while (budgetCount < MAX &&
           fscanf(fp, "%d|%49[^|]|%f|%f", &budgets[budgetCount].id,
                  budgets[budgetCount].department, &budgets[budgetCount].revenue,
                  &budgets[budgetCount].expenses) == 4)
        budgetCount++;
    fclose(fp);
    return 1;
}

/* ---------- BINARY save/load (employees) ---------- */
int saveEmployeesBinary()
{
    FILE *fp = fopen(DATA_DIR "/employees.dat", "wb");
    if (fp == NULL) { perror("Cannot open employees.dat for writing"); return 0; }
    fwrite(&employeeCount, sizeof(int), 1, fp);
    fwrite(employees, sizeof(Employee), employeeCount, fp);
    fclose(fp);
    return 1;
}

int loadEmployeesBinary()
{
    int count;
    FILE *fp = fopen(DATA_DIR "/employees.dat", "rb");
    if (fp == NULL) { printf("No employees.dat found (nothing to load).\n"); return 0; }
    if (fread(&count, sizeof(int), 1, fp) != 1 || count < 0 || count > MAX) {
        printf("employees.dat is damaged.\n");
        fclose(fp);
        return 0;
    }
    employeeCount = (int)fread(employees, sizeof(Employee), count, fp);
    fclose(fp);
    return 1;
}

/* ---------- save/load everything (text) ---------- */
void saveData()
{
    if (saveEmployeesText() && saveSuppliersText() && saveAssetsText() && saveBudgetsText())
        printf("All data saved to the %s folder.\n", DATA_DIR);
    else
        printf("Some data could not be saved.\n");
}

void loadData()
{
    loadEmployeesText();
    loadSuppliersText();
    loadAssetsText();
    loadBudgetsText();
    printf("Load finished: %d employees, %d suppliers, %d assets, %d budgets.\n",
           employeeCount, supplierCount, assetCount, budgetCount);
}

/* ---------- menu ---------- */
void displayMenu()
{
    printf("\n==================================\n");
    printf("MUNICIPAL FINANCIAL MANAGEMENT\n");
    printf("==================================\n");
    printf("1. Add Employee\n");
    printf("2. Add Supplier\n");
    printf("3. Add Asset\n");
    printf("4. Add Budget\n");
    printf("5. View All Records\n");
    printf("6. Save Data (text)\n");
    printf("7. Load Data (text)\n");
    printf("8. Save Employees (binary)\n");
    printf("9. Load Employees (binary)\n");
    printf("0. Exit\n");
    printf("Enter choice: ");
}

int main()
{
    int choice;

    MAKE_DIR(DATA_DIR);   /* creates the folder; harmless if it already exists */

    do {
        displayMenu();
        choice = readInt("");

        switch (choice) {
            case 1: addEmployee(); break;
            case 2: addSupplier(); break;
            case 3: addAsset(); break;
            case 4: addBudget(); break;
            case 5: viewAll(); break;
            case 6: saveData(); break;
            case 7: loadData(); break;
            case 8: if (saveEmployeesBinary()) printf("Employees saved (binary).\n"); break;
            case 9: if (loadEmployeesBinary()) printf("Loaded %d employees (binary).\n", employeeCount); break;
            case 0: printf("Goodbye!\n"); break;
            default: printf("Invalid choice. Try again.\n");
        }
    } while (choice != 0);

    return 0;
}
