#include <stdio.h>
#include <string.h>

#ifdef _WIN32
#include <direct.h>
#define MAKE_DIR(p) _mkdir(p)
#else
#include <sys/stat.h>
#define MAKE_DIR(p) mkdir(p, 0755)
#endif

#define MAX 100
#define DATA_DIR "data"

typedef struct { int id; char name[50]; float salary; } Employee;
typedef struct { int id; char name[50]; char town[30]; } Supplier;
typedef struct { int id; char name[50]; float value; } Asset;
typedef struct { int id; char department[50]; float revenue; float expenses; } Budget;

Employee employees[MAX];  int employeeCount = 0;
Supplier suppliers[MAX];  int supplierCount = 0;
Asset    assets[MAX];     int assetCount = 0;
Budget   budgets[MAX];    int budgetCount = 0;

/* ---------- input helpers ---------- */
void readLine(char *buf, int size)
{
    fgets(buf, size, stdin);
    buf[strcspn(buf, "\n")] = '\0';
}

int readInt(const char *prompt)
{
    char line[50];
    int v;
    printf("%s", prompt);
    fgets(line, sizeof(line), stdin);
    if (sscanf(line, "%d", &v) != 1) return -1;
    return v;
}

float readFloat(const char *prompt)
{
    char line[50];
    float v;
    printf("%s", prompt);
    fgets(line, sizeof(line), stdin);
    if (sscanf(line, "%f", &v) != 1) return 0;
    return v;
}

/* ---------- add records ---------- */
void addEmployee()
{
    if (employeeCount >= MAX) { printf("Employee list full.\n"); return; }
    Employee *e = &employees[employeeCount];
    e->id = readInt("Enter employee ID: ");
    printf("Enter name: ");
    readLine(e->name, sizeof(e->name));
    e->salary = readFloat("Enter salary: ");
    employeeCount++;
}

void addSupplier()
{
    if (supplierCount >= MAX) { printf("Supplier list full.\n"); return; }
    Supplier *s = &suppliers[supplierCount];
    s->id = readInt("Enter supplier ID: ");
    printf("Enter name: ");
    readLine(s->name, sizeof(s->name));
    printf("Enter town: ");
    readLine(s->town, sizeof(s->town));
    supplierCount++;
}

void addAsset()
{
    if (assetCount >= MAX) { printf("Asset list full.\n"); return; }
    Asset *a = &assets[assetCount];
    a->id = readInt("Enter asset ID: ");
    printf("Enter name: ");
    readLine(a->name, sizeof(a->name));
    a->value = readFloat("Enter value: ");
    assetCount++;
}

void addBudget()
{
    if (budgetCount >= MAX) { printf("Budget list full.\n"); return; }
    Budget *b = &budgets[budgetCount];
    b->id = readInt("Enter budget ID: ");
    printf("Enter department: ");
    readLine(b->department, sizeof(b->department));
    b->revenue = readFloat("Enter revenue: ");
    b->expenses = readFloat("Enter expenses: ");
    budgetCount++;
}

/* ---------- view records ---------- */
void viewAll()
{
    int i;
    printf("\n--- EMPLOYEES (%d) ---\n", employeeCount);
    for (i = 0; i < employeeCount; i++)
        printf("%d | %s | %.2f\n", employees[i].id, employees[i].name, employees[i].salary);

    printf("\n--- SUPPLIERS (%d) ---\n", supplierCount);
    for (i = 0; i < supplierCount; i++)
        printf("%d | %s | %s\n", suppliers[i].id, suppliers[i].name, suppliers[i].town);

    printf("\n--- ASSETS (%d) ---\n", assetCount);
    for (i = 0; i < assetCount; i++)
        printf("%d | %s | %.2f\n", assets[i].id, assets[i].name, assets[i].value);

    printf("\n--- BUDGETS (%d) ---\n", budgetCount);
    for (i = 0; i < budgetCount; i++)
        printf("%d | %s | %.2f | %.2f\n", budgets[i].id, budgets[i].department,
               budgets[i].revenue, budgets[i].expenses);
}

/* ---------- TEXT save ---------- */
int saveEmployeesText()
{
    int i;
    FILE *fp = fopen(DATA_DIR "/employees.txt", "w");
    if (fp == NULL) { perror("Cannot open employees.txt for writing"); return 0; }
    for (i = 0; i < employeeCount; i++)
        fprintf(fp, "%d|%s|%.2f\n", employees[i].id, employees[i].name, employees[i].salary);
    fclose(fp);
    return 1;
}

